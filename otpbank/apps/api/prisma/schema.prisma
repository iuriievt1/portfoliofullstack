generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPPORT
  RISK_ANALYST
  COMPLIANCE_OFFICER
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  LOCKED
  CLOSED
}

enum Currency {
  CZK
  EUR
  USD
}

enum AccountType {
  CURRENT
  SAVINGS
  INTERNAL_SUSPENSE
  INTERNAL_FEE_REVENUE
}

enum AccountStatus {
  PENDING
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
  MEMO
}

enum LedgerLineDirection {
  DEBIT
  CREDIT
}

enum JournalEntryType {
  TRANSFER
  FEE
  ADJUSTMENT
  REVERSAL
  CARD_AUTH_HOLD
  CARD_CAPTURE
  RELEASE_HOLD
}

enum TransferType {
  INTERNAL
  OWN_ACCOUNT
  MANUAL_ADJUSTMENT
}

enum TransferStatus {
  PENDING_REVIEW
  PROCESSING
  POSTED
  REJECTED
  FAILED
  REVERSED
}

enum BeneficiaryStatus {
  ACTIVE
  BLOCKED
}

enum CardStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum OTPPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  LOGIN_2FA
  PASSWORD_RESET
  STEP_UP
}

enum OTPStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  BLOCKED
}

enum KYCStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  VERIFIED
  REJECTED
  REQUIRES_ENHANCED_REVIEW
}

enum KYCDocumentType {
  PASSPORT
  ID_CARD
  RESIDENCE_PERMIT
  SELFIE
  PROOF_OF_ADDRESS
  SOURCE_OF_FUNDS
}

enum DocumentType {
  STATEMENT
  RECEIPT
  TERMS
  PRIVACY
  OTHER
}

enum AuditActorType {
  USER
  ADMIN
  SUPPORT
  SYSTEM
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
  PROFILING
}

enum SupportSessionMode {
  NONE
  EXPLICIT_ASSIST_VIEW
}

enum FeeCalculationType {
  FIXED
  PERCENTAGE
}

model User {
  id                     String            @id @default(uuid())
  email                  String            @unique
  phone                  String?           @unique
  passwordHash           String
  status                 UserStatus        @default(PENDING)
  failedLoginCount       Int               @default(0)
  lockedUntil            DateTime?
  emailVerifiedAt        DateTime?
  phoneVerifiedAt        DateTime?
  mfaEnabled             Boolean           @default(false)
  defaultCurrency        Currency          @default(CZK)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  profile                UserProfile?
  roles                  UserRole[]
  accounts               Account[]
  beneficiaries          Beneficiary[]     @relation("BeneficiaryOwner")
  sourceTransfers        Transfer[]        @relation("TransferSourceUser")
  destinationTransfers   Transfer[]        @relation("TransferDestinationUser")
  sessions               Session[]
  otps                   OTP[]
  consents               Consent[]
  kycRecords             KYCRecord[]
  notifications          Notification[]
  documents              Document[]
  supportNotes           SupportNote[]     @relation("SupportNoteTarget")
  createdTransfers       Transfer[]        @relation("TransferCreatedBy")
  auditLogs              AuditLog[]        @relation("AuditUser")
  riskEvents             RiskEvent[]
  idempotencyKeys        IdempotencyKey[]
  transactionViews       TransactionView[]
  createdProviderConfigs ProviderConfig[]  @relation("ProviderConfigCreatedBy")

  @@index([status, createdAt])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model UserProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  firstName        String?
  lastName         String?
  dateOfBirth      DateTime?
  nationalIdMasked String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  postalCode       String?
  countryCode      String?
  riskCountryCode  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Consent {
  id         String      @id @default(uuid())
  userId     String
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, acceptedAt])
}

model KYCRecord {
  id                  String        @id @default(uuid())
  userId              String
  status              KYCStatus     @default(NOT_STARTED)
  provider            String
  providerCaseId      String?
  pepScreening        String?
  sanctionsScreening  String?
  sourceOfFundsStatus String?
  reviewerUserId      String?
  reviewNotes         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents           KYCDocument[]

  @@index([status, createdAt])
  @@index([userId])
}

model KYCDocument {
  id          String          @id @default(uuid())
  kycRecordId String
  type        KYCDocumentType
  storageKey  String
  mimeType    String
  fileName    String
  uploadedAt  DateTime        @default(now())
  reviewedAt  DateTime?
  kycRecord   KYCRecord       @relation(fields: [kycRecordId], references: [id], onDelete: Cascade)

  @@index([kycRecordId, type])
}

model Account {
  id                    String            @id @default(uuid())
  userId                String?
  type                  AccountType
  status                AccountStatus     @default(PENDING)
  currency              Currency
  iban                  String            @unique
  accountNumberMasked   String
  nickname              String?
  availableBalanceMinor BigInt            @default(0)
  pendingBalanceMinor   BigInt            @default(0)
  reservedBalanceMinor  BigInt            @default(0)
  dailyLimitMinor       BigInt            @default(50000000)
  isPrimary             Boolean           @default(false)
  frozenReason          String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  ledgerAccount         LedgerAccount?
  sourceTransfers       Transfer[]        @relation("TransferSource")
  destinationTransfers  Transfer[]        @relation("TransferDestination")
  cards                 Card[]
  beneficiaries         Beneficiary[]     @relation("BeneficiaryAccount")
  transactionViews      TransactionView[]
  supportNotes          SupportNote[]     @relation("SupportNoteAccount")

  @@index([userId, status, createdAt])
  @@index([currency, status])
}

model LedgerAccount {
  id                 String            @id @default(uuid())
  accountId          String?           @unique
  code               String            @unique
  name               String
  type               LedgerAccountType
  currency           Currency
  allowManualPosting Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  account            Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  lines              LedgerLine[]

  @@index([type, currency])
}

model JournalEntry {
  id                  String           @id @default(uuid())
  type                JournalEntryType
  reference           String           @unique
  transferId          String?
  externalReference   String?
  description         String
  createdByUserId     String?
  approvalActorUserId String?
  createdAt           DateTime         @default(now())
  transfer            Transfer?        @relation(fields: [transferId], references: [id], onDelete: SetNull)
  lines               LedgerLine[]

  @@index([type, createdAt])
  @@index([transferId])
}

model LedgerLine {
  id              String              @id @default(uuid())
  journalEntryId  String
  ledgerAccountId String
  direction       LedgerLineDirection
  amountMinor     BigInt
  createdAt       DateTime            @default(now())
  journalEntry    JournalEntry        @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount       @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([ledgerAccountId, createdAt])
}

model Transfer {
  id                   String            @id @default(uuid())
  type                 TransferType
  status               TransferStatus
  sourceAccountId      String
  destinationAccountId String
  sourceUserId         String?
  destinationUserId    String?
  createdByUserId      String?
  amountMinor          BigInt
  feeMinor             BigInt            @default(0)
  totalDebitMinor      BigInt
  currency             Currency
  reference            String            @unique
  description          String?
  reason               String?
  riskDecision         String?
  receiptStorageKey    String?
  idempotencyKeyId     String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  postedAt             DateTime?
  sourceAccount        Account           @relation("TransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount   Account           @relation("TransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  sourceUser           User?             @relation("TransferSourceUser", fields: [sourceUserId], references: [id], onDelete: SetNull)
  destinationUser      User?             @relation("TransferDestinationUser", fields: [destinationUserId], references: [id], onDelete: SetNull)
  createdByUser        User?             @relation("TransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  journalEntries       JournalEntry[]
  transactionViews     TransactionView[]
  riskEvents           RiskEvent[]

  @@index([sourceAccountId, createdAt])
  @@index([destinationAccountId, createdAt])
  @@index([status, createdAt])
  @@index([createdByUserId, createdAt])
}

model TransactionView {
  id                String              @id @default(uuid())
  userId            String?
  accountId         String
  transferId        String
  direction         LedgerLineDirection
  counterpartyName  String?
  amountMinor       BigInt
  feeMinor          BigInt              @default(0)
  balanceAfterMinor BigInt
  currency          Currency
  reference         String
  description       String?
  bookedAt          DateTime
  createdAt         DateTime            @default(now())
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  account           Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transfer          Transfer            @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([accountId, bookedAt])
  @@index([userId, bookedAt])
  @@index([reference])
}

model Beneficiary {
  id                   String            @id @default(uuid())
  ownerUserId          String
  beneficiaryAccountId String
  alias                String
  status               BeneficiaryStatus @default(ACTIVE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  owner                User              @relation("BeneficiaryOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  beneficiaryAccount   Account           @relation("BeneficiaryAccount", fields: [beneficiaryAccountId], references: [id], onDelete: Restrict)

  @@unique([ownerUserId, beneficiaryAccountId])
  @@index([ownerUserId, status])
}

model Card {
  id                 String            @id @default(uuid())
  accountId          String
  maskedPan          String
  holderName         String
  brand              String
  status             CardStatus        @default(ACTIVE)
  isVirtual          Boolean           @default(true)
  onlineEnabled      Boolean           @default(true)
  contactlessEnabled Boolean           @default(true)
  atmEnabled         Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions       CardTransaction[]

  @@index([accountId, status])
}

model CardTransaction {
  id            String   @id @default(uuid())
  cardId        String
  transferId    String?
  merchantName  String
  amountMinor   BigInt
  currency      Currency
  status        String
  authReference String?
  createdAt     DateTime @default(now())
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

model Session {
  id                String        @id @default(uuid())
  userId            String
  status            SessionStatus @default(ACTIVE)
  deviceFingerprint String?
  deviceName        String?
  ipAddress         String?
  userAgent         String?
  lastSeenAt        DateTime      @default(now())
  refreshTokenHash  String?
  csrfToken         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  expiresAt         DateTime
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([expiresAt])
}

model OTP {
  id          String     @id @default(uuid())
  userId      String
  purpose     OTPPurpose
  codeHash    String
  destination String
  status      OTPStatus  @default(PENDING)
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, status, expiresAt])
}

model AuditLog {
  id           String         @id @default(uuid())
  actorType    AuditActorType
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  reason       String?
  requestId    String?
  ipAddress    String?
  metadataJson Json?
  createdAt    DateTime       @default(now())
  actorUser    User?          @relation("AuditUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model Notification {
  id                String             @id @default(uuid())
  userId            String
  channel           String
  template          String
  subject           String?
  body              String
  status            NotificationStatus @default(PENDING)
  providerMessageId String?
  createdAt         DateTime           @default(now())
  sentAt            DateTime?
  readAt            DateTime?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model RiskEvent {
  id              String       @id @default(uuid())
  userId          String?
  transferId      String?
  severity        RiskSeverity
  status          RiskStatus   @default(OPEN)
  code            String
  title           String
  description     String
  payloadJson     Json?
  reviewerUserId  String?
  resolutionNotes String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  transfer        Transfer?    @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([status, severity, createdAt])
  @@index([userId, createdAt])
  @@index([transferId])
}

model FeeRule {
  id              String             @id @default(uuid())
  name            String             @unique
  active          Boolean            @default(true)
  currency        Currency
  calculationType FeeCalculationType
  fixedMinor      BigInt?
  percentageBps   Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([active, currency])
}

model LimitRule {
  id              String   @id @default(uuid())
  name            String   @unique
  active          Boolean  @default(true)
  currency        Currency
  dailyLimitMinor BigInt
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, currency])
}

model SupportNote {
  id               String             @id @default(uuid())
  targetUserId     String?
  relatedAccountId String?
  authorUserId     String
  visibility       SupportSessionMode @default(NONE)
  note             String
  createdAt        DateTime           @default(now())
  targetUser       User?              @relation("SupportNoteTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  relatedAccount   Account?           @relation("SupportNoteAccount", fields: [relatedAccountId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([authorUserId, createdAt])
}

model Document {
  id          String       @id @default(uuid())
  userId      String?
  type        DocumentType
  storageKey  String
  title       String
  generatedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type, createdAt])
}

model IdempotencyKey {
  id           String            @id @default(uuid())
  actorUserId  String?
  scope        String
  key          String
  status       IdempotencyStatus @default(PENDING)
  requestHash  String?
  responseJson Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  expiresAt    DateTime
  actorUser    User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([actorUserId, scope, key])
  @@index([scope, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payloadJson   Json
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId])
}

model ProviderConfig {
  id                  String   @id @default(uuid())
  providerType        String
  providerName        String
  active              Boolean  @default(true)
  configJsonEncrypted String
  createdByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdByUser       User?    @relation("ProviderConfigCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([providerType, providerName])
}
