{
  "name": "vybe-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @vybe/api run start:dev",
    "dev:web": "npm --workspace @vybe/web run dev",
    "build": "npm-run-all build:shared build:api build:web",
    "build:shared": "npm --workspace @vybe/shared-types run build",
    "build:api": "npm --workspace @vybe/api run build",
    "build:web": "npm --workspace @vybe/web run build",
    "lint": "npm-run-all lint:api lint:web",
    "lint:api": "npm --workspace @vybe/api run lint",
    "lint:web": "npm --workspace @vybe/web run lint",
    "db:generate": "npm --workspace @vybe/api run prisma:generate",
    "db:migrate": "npm --workspace @vybe/api run prisma:migrate",
    "db:seed": "npm --workspace @vybe/api run prisma:seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}

