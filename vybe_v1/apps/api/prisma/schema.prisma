generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlaceType {
  cafe
  bar
  lounge
  coworking
  nightlife
}

enum CrowdLevel {
  low
  medium
  high
  packed
}

enum NoiseLevel {
  quiet
  social
  loud
  wild
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  city         String?
  trustScore   Float    @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  posts        Post[]
  likes        Like[]
}

model Place {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  type          PlaceType
  description   String?
  city          String
  address       String
  latitude      Float
  longitude     Float
  verified      Boolean   @default(false)
  coverImageUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  posts         Post[]

  @@index([city, type])
}

model Post {
  id          String      @id @default(cuid())
  userId      String
  placeId     String
  text        String
  imageUrl    String?
  vibe        Int
  crowdLevel  CrowdLevel
  noiseLevel  NoiseLevel
  waitTimeMin Int?
  isActive    Boolean     @default(true)
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  place       Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  likes       Like[]

  @@index([placeId, createdAt])
  @@index([isActive, expiresAt, createdAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

