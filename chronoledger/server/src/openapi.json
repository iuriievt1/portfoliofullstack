{
  "openapi": "3.0.0",
  "info": {
    "title": "ChronoLedger API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4010"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "responses": {
          "200": {
            "description": "registered"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "responses": {
          "200": {
            "description": "logged in"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "responses": {
          "200": {
            "description": "refreshed"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "description": "logged out"
          }
        }
      }
    },
    "/api/orgs/current": {
      "get": {
        "responses": {
          "200": {
            "description": "current org"
          }
        }
      }
    },
    "/api/orgs/{orgId}/branches": {
      "get": {
        "responses": {
          "200": {
            "description": "branches"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "created"
          }
        }
      }
    },
    "/api/orgs/{orgId}/branches/{branchId}/events": {
      "get": {
        "responses": {
          "200": {
            "description": "events"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "appended"
          }
        }
      }
    },
    "/api/orgs/{orgId}/branches/{branchId}/state": {
      "get": {
        "responses": {
          "200": {
            "description": "state"
          }
        }
      }
    },
    "/api/orgs/{orgId}/branches/{branchId}/verify": {
      "get": {
        "responses": {
          "200": {
            "description": "verify"
          }
        }
      }
    },
    "/api/public/append": {
      "post": {
        "responses": {
          "200": {
            "description": "ingested"
          }
        }
      }
    }
  }
}